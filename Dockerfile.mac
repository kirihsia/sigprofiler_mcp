# Use standard light Linux image for Mac/CPU
FROM python:3.10-slim

# Set the working directory inside the container
WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire project into the container
COPY . .

RUN pip install --no-cache-dir .

RUN chmod +x start.sh

# CRITICAL: Disable Python's output buffering
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Explicitly tell the Python script to disable GPU
ENV USE_GPU=False

# Expose the Streamlit viewer port
EXPOSE 8501

# Run the unified startup script (Streamlit viewer + MCP server)
CMD ["./start.sh"]
